{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/projects/configs/voice/bin/voice claude-stop",
            "async": true,
            "timeout": 15
          }
        ]
      }
    ]
  },
  "voice": {
    "enabled": true,
    "mode": "hold"
  }
}
